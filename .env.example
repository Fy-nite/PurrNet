# Copy to .env and fill in — for server 192.168.0.180 (host runs MariaDB)
ASPNETCORE_ENVIRONMENT=Production
PURRNET_HOST_PORT=8080
# Host MariaDB — your server 192.168.0.180 already runs it; container reaches host via 192.168.0.180 or host.docker.internal
MARIADB_HOST=192.168.0.180
# Or set full connection string directly (overrides MARIADB_HOST/_DATABASE/_USER/_PASSWORD):
# MARIADB_CONNECTION_STRING=Server=192.168.0.180;Database=PurrNet;User=purrnet;Password=your-pass;
MARIADB_DATABASE=PurrNet
MARIADB_USER=purrnet
MARIADB_PASSWORD=purrnet
# Only used with --profile internal-db (dev self-contained):
MARIADB_HOST_PORT=3306
MARIADB_ROOT_PASSWORD=purrnet-root-change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_PATH=/
