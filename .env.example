# Copy to .env and fill in — for server 192.168.0.180 (host runs MariaDB)
ASPNETCORE_ENVIRONMENT=Production
PURRNET_HOST_PORT=8080
# Host MariaDB — your server 192.168.0.180 already runs it
# INSIDE CONTAINER localhost != host. Use host.docker.internal or 192.168.0.180, never localhost.
MARIADB_HOST=host.docker.internal
# Or set full connection string directly (overrides MARIADB_HOST/_DATABASE/_USER/_PASSWORD):
# MARIADB_CONNECTION_STRING=Server=host.docker.internal;Port=3306;Database=PurrNet;User=purrnet;Password=your-pass;
# Alternative for host-network mariadb that only binds 127.0.0.1: use network_mode host (see README)
MARIADB_PORT=3306
MARIADB_DATABASE=PurrNet
MARIADB_USER=purrnet
MARIADB_PASSWORD=purrnet
# Only used with --profile internal-db (dev self-contained):
MARIADB_HOST_PORT=3306
MARIADB_ROOT_PASSWORD=purrnet-root-change-me
# Run DB/container on a specific drive (HDD slow → put on SSD):
# Set to absolute host path on fast drive, e.g. /mnt/ssd/purrnet-db or D:/purrnet-db
# If left empty, uses Docker named volume db_data (default location, often on system drive)
# DB_DATA_HOST_PATH=/mnt/fastdrive/purrnet-db
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_PATH=/
